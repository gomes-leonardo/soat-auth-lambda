{
  "name": "soat-auth-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Funcoes serverless da oficina: autenticacao por CPF e notificacao de alertas",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"{functions,local,test,scripts}/**/*.{ts,mjs}\"",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "start:local": "node dist/local-server.js"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
